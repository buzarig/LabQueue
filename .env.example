# Шаблон локального оточення. Скопіюйте в .env і вкажіть пароль ролі labqueue.
# .env ігнорує git; сюди секрети не пишемо (MAN-06).
# Середовище й створення ролі та БД — README, «Середовище».

# Застосунок, make db-migrate, make db-seed
DATABASE_URL=postgres://labqueue:CHANGE_ME@localhost:5432/labqueue_dev

# Тести й make check (БД очищається тестами)
TEST_DATABASE_URL=postgres://labqueue:CHANGE_ME@localhost:5432/labqueue_test
